<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_selected="true"><shape><solid android:color="@color/ai_selected" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/ai_primary" /></shape></item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
    <item android:id="@android:id/mask"><shape><solid android:color="@android:color/white" /><corners android:radius="12dp" /></shape></item>
</ripple>
