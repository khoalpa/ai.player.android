<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PlayerMenuTheme">
        <item name="android:popupWindowStyle">@style/PlayerMenuWindow</item>
        <item name="android:listPreferredItemHeightSmall">48dp</item>
    </style>
    <style name="PlayerMenuWindow" parent="@android:style/Widget.Material.PopupWindow">
        <item name="android:popupBackground">@drawable/player_menu_background</item>
    </style>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ai_background</item>
        <item name="android:navigationBarColor">@color/ai_background</item>
        <item name="android:colorBackground">@color/ai_background</item>
        <item name="android:colorBackgroundFloating">@color/ai_surface</item>
        <item name="android:colorAccent">@color/ai_primary</item>
        <item name="android:windowBackground">@color/ai_background</item>
        <item name="android:textColorPrimary">@color/ai_text</item>
        <item name="android:textColorSecondary">@color/ai_muted</item>
        <item name="playerSelection">#16324A</item>
        <item name="playerAccentText">#000000</item>
        <item name="playerButtonSurface">#262626</item>
        <item name="playerButtonDisabled">#171717</item>
        <item name="playerButtonDisabledInk">#929292</item>
        <item name="playerButtonAccentInk">#8AB8FF</item>
        <item name="playerButtonDanger">#42242B</item>
        <item name="playerButtonDangerInk">#FF9B9B</item>
        <item name="playerIconNeutral">#BDBDBD</item>
        <item name="playerIconSuccess">#7CDDA0</item>
        <item name="playerIconWarning">#FFD487</item>
    </style>
    <style name="AppThemeLight" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F5F6F8</item>
        <item name="android:navigationBarColor">#172033</item>
        <item name="android:colorBackground">#F5F6F8</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:colorAccent">#2459C4</item>
        <item name="android:windowBackground">#F5F6F8</item>
        <item name="android:textColorPrimary">#172033</item>
        <item name="android:textColorSecondary">#536176</item>
        <item name="playerSelection">#E6EDFF</item>
        <item name="playerAccentText">#FFFFFF</item>
        <item name="playerButtonSurface">#E5E9F0</item>
        <item name="playerButtonDisabled">#EEF1F5</item>
        <item name="playerButtonDisabledInk">#64748B</item>
        <item name="playerButtonAccentInk">#2459C4</item>
        <item name="playerButtonDanger">#FDEBEE</item>
        <item name="playerButtonDangerInk">#B42A35</item>
        <item name="playerIconNeutral">#536176</item>
        <item name="playerIconSuccess">#18703D</item>
        <item name="playerIconWarning">#865500</item>
    </style>
</resources>
